{
  "name": "listingboost",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "test": "bun test tests/unit tests/integration tests/security",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:security": "bun test tests/security",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "setup": "bash scripts/setup.sh",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^6",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  }
}
