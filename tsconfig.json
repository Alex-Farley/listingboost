{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "@cloudflare/workers-types"],
    "paths": {
      "@listingboost/domain": ["./packages/domain/src/index.ts"],
      "@listingboost/database": ["./packages/database/src/index.ts"],
      "@listingboost/storage": ["./packages/storage/src/index.ts"],
      "@listingboost/ai": ["./packages/ai/src/index.ts"],
      "@listingboost/generation": ["./packages/generation/src/index.ts"],
      "@listingboost/templates": ["./packages/templates/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests", "scripts", "*.ts"],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
